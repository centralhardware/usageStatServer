<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>me.centralhardware.usage-agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/usage-agent</string>
    </array>
    <!-- Only in a logged-in GUI session: it needs the frontmost app. -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/Shared/usage-agent.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Shared/usage-agent.log</string>
</dict>
</plist>
